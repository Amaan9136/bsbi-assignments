<?xml version="1.0"?>
<launch>

  <!-- TurtleBot3 model. Must match the model used in TheConstruct's
       TurtleBot3 simulation (commonly 'burger' or 'waffle_pi'). -->
  <arg name="model" default="waffle_pi" />
  <env name="TURTLEBOT3_MODEL" value="$(arg model)" />

  <!-- Camera topic the perception node subscribes to. Overridable at
       launch time, e.g. roslaunch turtlebot3_vision_nav vision_nav.launch
       camera_topic:=/camera/rgb/image_raw -->
  <arg name="camera_topic" default="/camera/rgb/image_raw" />

  <!-- Bring up the TurtleBot3 world in Gazebo. This include assumes the
       standard turtlebot3_gazebo package is available in the ROSject
       workspace, as it is by default on TheConstruct.ai TurtleBot3
       simulations. -->
  <include file="$(find turtlebot3_gazebo)/launch/turtlebot3_world.launch" />

  <!-- Perception node -->
  <node pkg="turtlebot3_vision_nav" type="vision_detector.py" name="vision_detector"
        output="screen">
    <param name="camera_topic" value="$(arg camera_topic)" />
  </node>

  <!-- Navigation node -->
  <node pkg="turtlebot3_vision_nav" type="navigation_controller.py" name="navigation_controller"
        output="screen">
    <param name="control_rate" value="10" />
  </node>

</launch>
