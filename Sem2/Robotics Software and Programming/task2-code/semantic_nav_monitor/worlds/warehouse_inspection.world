<?xml version="1.0" ?>
<!--
  warehouse_inspection.world

  Custom Gazebo world for Task 2 (Goal-Oriented Autonomous Robot with
  Monitoring). Represents the assignment's chosen use-case scenario:

    USE CASE: "Warehouse Inspection Patrol Robot"
    The TurtleBot3 patrols a closed loop of four inspection checkpoints
    around a small warehouse bay. Eight pallet obstacles - two per patrol
    leg - sit near the route so the robot is forced to exercise its
    AVOID_OBSTACLE and REPLAN states repeatedly during every run, not just
    NAVIGATE.

  Layout (world frame, metres):
    - Room walls form a 7.0m x 7.0m enclosed bay: x in [-2.0, 5.0], y in [-2.0, 5.0]
    - Checkpoints (visual-only markers, no collision) sit at the mission's
      four waypoints: (3.0, 0.0), (3.0, 3.0), (0.0, 3.0), (0.0, 0.0)
    - The (0.0, 0.0) checkpoint doubles as the "charging dock" (green)
    - Pallet obstacles 1-2 sit on the (0.0,0.0) -> (3.0,0.0) leg
    - Pallet obstacles 3-4 sit on the (3.0,0.0) -> (3.0,3.0) leg
    - Pallet obstacles 5-6 sit on the (3.0,3.0) -> (0.0,3.0) leg
    - Pallet obstacles 7-8 sit on the (0.0,3.0) -> (0.0,0.0) leg
    - Each pallet in a pair sits 0.9m off the direct waypoint-to-waypoint
      line, on opposite sides and at different points along the leg, so
      the robot always has a wide (>1.5m) open corridor on one side and
      never faces obstacles blocking both sides of the path at once.
-->
<sdf version="1.6">
  <world name="warehouse_inspection">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ================= Warehouse bay walls ================= -->
    <model name="wall_north">
      <static>true</static>
      <pose>1.5 5.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>7.1 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>7.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>1.5 -2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>7.1 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>7.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5.0 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 7.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 7.1 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-2.0 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 7.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 7.1 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= Pallet obstacles (force AVOID_OBSTACLE/REPLAN) =================
         Eight obstacles, two per patrol leg, each offset 0.9m to one side of the
         direct waypoint-to-waypoint line and staggered along the leg, so they form
         a light chicane with a wide (>1.5m) open corridor on one side at any point
         along the route - never a pincer that blocks both sides at once. -->
    <model name="pallet_obstacle_1">
      <static>true</static>
      <pose>1.05 0.90 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.65 0.45 0.15 1</ambient><diffuse>0.65 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_obstacle_2">
      <static>true</static>
      <pose>1.95 -0.90 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.65 0.45 0.15 1</ambient><diffuse>0.65 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_obstacle_3">
      <static>true</static>
      <pose>2.10 1.05 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.65 0.45 0.15 1</ambient><diffuse>0.65 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_obstacle_4">
      <static>true</static>
      <pose>3.90 1.95 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.65 0.45 0.15 1</ambient><diffuse>0.65 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_obstacle_5">
      <static>true</static>
      <pose>1.95 2.10 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.65 0.45 0.15 1</ambient><diffuse>0.65 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_obstacle_6">
      <static>true</static>
      <pose>1.05 3.90 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.65 0.45 0.15 1</ambient><diffuse>0.65 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_obstacle_7">
      <static>true</static>
      <pose>0.90 1.95 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.65 0.45 0.15 1</ambient><diffuse>0.65 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_obstacle_8">
      <static>true</static>
      <pose>-0.90 1.05 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.65 0.45 0.15 1</ambient><diffuse>0.65 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= Inspection checkpoint markers (visual-only, no collision) ================= -->
    <model name="checkpoint_marker_1">
      <static>true</static>
      <pose>3.0 0.0 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="checkpoint_marker_2">
      <static>true</static>
      <pose>3.0 3.0 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="checkpoint_marker_3">
      <static>true</static>
      <pose>0.0 3.0 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.9 0.2 0.2 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Checkpoint 0 doubles as the charging dock: robot starts and mission completes here -->
    <model name="charging_dock_marker">
      <static>true</static>
      <pose>0.0 0.0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>