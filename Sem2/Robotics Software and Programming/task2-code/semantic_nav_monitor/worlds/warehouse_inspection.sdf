      <pose>-0.90 1.05 0 0 0 0</pose>
      <link name="link">
        <collision name="collision_l1">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>0.28 0.28 0.09</size></box></geometry>
