<?xml version="1.0" ?>
<!--
  warehouse_inspection.sdf

  Custom Gazebo world for Task 2 (Goal-Oriented Autonomous Robot with
  Monitoring). Represents the assignment's chosen use-case scenario:

    USE CASE: "Warehouse Inspection Patrol Robot"
    The TurtleBot3 patrols a closed loop of four inspection checkpoints
    around a small warehouse bay. Eight pallet obstacles - two per patrol
    leg - sit near the route so the robot is forced to exercise its
    AVOID_OBSTACLE and REPLAN states repeatedly during every run, not just
    NAVIGATE.

  Layout (world frame, metres):
    - Room walls form a 7.0m x 7.0m enclosed bay: x in [-2.0, 5.0], y in [-2.0, 5.0]
    - Checkpoints (visual-only markers, no collision) sit at the mission's
      four waypoints: (3.0, 0.0), (3.0, 3.0), (0.0, 3.0), (0.0, 0.0)
    - The (0.0, 0.0) checkpoint doubles as the "charging dock" (green)
    - Pallet obstacles 1-2 sit on the (0.0,0.0) -> (3.0,0.0) leg
    - Pallet obstacles 3-4 sit on the (3.0,0.0) -> (3.0,3.0) leg
    - Pallet obstacles 5-6 sit on the (3.0,3.0) -> (0.0,3.0) leg
    - Pallet obstacles 7-8 sit on the (0.0,3.0) -> (0.0,0.0) leg
    - Each pallet in a pair sits 0.9m off the direct waypoint-to-waypoint
      line, on opposite sides and at different points along the leg, so
      the robot always has a wide (>1.5m) open corridor on one side and
      never faces obstacles blocking both sides of the path at once.
    - Each pallet obstacle is now a small stack of 2-4 boxes (visually a
      warehouse pallet stack) instead of one 0.3m cube, with a similar or
      smaller XY footprint so the waypoint/corridor geometry is unchanged.
    - Pallet obstacles 2, 4, 6 and 8 are the corner stacks: measuring every
      obstacle's distance to its nearest wall (x=-2, x=5, y=-2, y=5) shows
      2/4/6/8 sit only ~1.1m from a wall (south/east/north/west
      respectively) while 1/3/5/7 sit ~2.9m from any wall. 2/4/6/8 are
      therefore built as taller 4-box stacks and are the ones that force
      the robot's avoidance logic to weight nearby-wall proximity so it
      doesn't turn into the wall.
    - Three small warning-pylon obstacles sit on the (0.0,0.0)->(3.0,0.0)
      leg, straddling its centerline (y=0) at x=0.80/1.60/2.40: one offset
      left (y=+0.30), one offset right (y=-0.30), one dead-center (y=0.0).
      Each is still inside the robot's ~0.23m corridor half-width so the
      robot must genuinely detect and steer around them, but they are now
      spaced 0.8m apart so a clear escape heading always exists past the
      nearest pylon instead of two/three blocking every avoidance angle
      at once.
-->
<sdf version="1.11">
  <world name="warehouse_inspection">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ================= Warehouse bay walls ================= -->
    <model name="wall_north">
      <static>true</static>
      <pose>1.5 5.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>7.1 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>7.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>1.5 -2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>7.1 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>7.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5.0 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 7.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 7.1 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-2.0 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 7.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 7.1 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= Pallet obstacles (force AVOID_OBSTACLE) =================
         Eight stacked-box pallets, two per patrol leg, each offset 0.9m to one side
         of the direct waypoint-to-waypoint line and staggered along the leg, so they
         form a light chicane with a wide (>1.5m) open corridor on one side at any
         point along the route - never a pincer that blocks both sides at once.
         Obstacles 2/4/6/8 are the wall-side ("corner") stacks - see header note. -->
    <model name="pallet_obstacle_1">
      <static>true</static>
      <pose>1.05 0.90 0 0 0 0</pose>
      <link name="link">
        <collision name="collision_bottom">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.28 0.28 0.14</size></box></geometry>
        </collision>
        <visual name="visual_bottom">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.28 0.28 0.14</size></box></geometry>
          <material><ambient>0.55 0.35 0.12 1</ambient><diffuse>0.55 0.35 0.12 1</diffuse></material>
        </visual>
        <collision name="collision_top">
          <pose>0 0 0.22 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.14</size></box></geometry>
        </collision>
        <visual name="visual_top">
          <pose>0 0 0.22 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.14</size></box></geometry>
          <material><ambient>0.60 0.40 0.15 1</ambient><diffuse>0.60 0.40 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_obstacle_2">
      <static>true</static>
      <pose>1.95 -0.90 0 0 0 0</pose>
      <link name="link">
        <collision name="collision_l1">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>0.28 0.28 0.09</size></box></geometry>
        </collision>
        <visual name="visual_l1">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>0.28 0.28 0.09</size></box></geometry>
          <material><ambient>0.55 0.35 0.12 1</ambient><diffuse>0.55 0.35 0.12 1</diffuse></material>
        </visual>
        <collision name="collision_l2">
          <pose>0 0 0.15 0 0 0</pose>
          <geometry><box><size>0.24 0.24 0.09</size></box></geometry>
        </collision>
        <visual name="visual_l2">
          <pose>0 0 0.15 0 0 0</pose>
          <geometry><box><size>0.24 0.24 0.09</size></box></geometry>
          <material><ambient>0.60 0.40 0.15 1</ambient><diffuse>0.60 0.40 0.15 1</diffuse></material>
        </visual>
        <collision name="collision_l3">
          <pose>0 0 0.24 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.09</size></box></geometry>
        </collision>
        <visual name="visual_l3">
          <pose>0 0 0.24 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.09</size></box></geometry>
          <material><ambient>0.50 0.30 0.10 1</ambient><diffuse>0.50 0.30 0.10 1</diffuse></material>
        </visual>
        <collision name="collision_l4">
          <pose>0 0 0.33 0 0 0</pose>
          <geometry><box><size>0.16 0.16 0.08</size></box></geometry>
        </collision>
        <visual name="visual_l4">
          <pose>0 0 0.33 0 0 0</pose>
          <geometry><box><size>0.16 0.16 0.08</size></box></geometry>
          <material><ambient>0.65 0.45 0.20 1</ambient><diffuse>0.65 0.45 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_obstacle_3">
      <static>true</static>
      <pose>2.10 1.05 0 0 0 0</pose>
      <link name="link">
        <collision name="collision_bottom">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.28 0.28 0.14</size></box></geometry>
        </collision>
        <visual name="visual_bottom">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.28 0.28 0.14</size></box></geometry>
          <material><ambient>0.55 0.35 0.12 1</ambient><diffuse>0.55 0.35 0.12 1</diffuse></material>
        </visual>
        <collision name="collision_top">
          <pose>0 0 0.22 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.14</size></box></geometry>
        </collision>
        <visual name="visual_top">
          <pose>0 0 0.22 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.14</size></box></geometry>
          <material><ambient>0.60 0.40 0.15 1</ambient><diffuse>0.60 0.40 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_obstacle_4">
      <static>true</static>
      <pose>3.90 1.95 0 0 0 0</pose>
      <link name="link">
        <collision name="collision_l1">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>0.28 0.28 0.09</size></box></geometry>
        </collision>
        <visual name="visual_l1">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>0.28 0.28 0.09</size></box></geometry>
          <material><ambient>0.55 0.35 0.12 1</ambient><diffuse>0.55 0.35 0.12 1</diffuse></material>
        </visual>
        <collision name="collision_l2">
          <pose>0 0 0.15 0 0 0</pose>
          <geometry><box><size>0.24 0.24 0.09</size></box></geometry>
        </collision>
        <visual name="visual_l2">
          <pose>0 0 0.15 0 0 0</pose>
          <geometry><box><size>0.24 0.24 0.09</size></box></geometry>
          <material><ambient>0.60 0.40 0.15 1</ambient><diffuse>0.60 0.40 0.15 1</diffuse></material>
        </visual>
        <collision name="collision_l3">
          <pose>0 0 0.24 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.09</size></box></geometry>
        </collision>
        <visual name="visual_l3">
          <pose>0 0 0.24 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.09</size></box></geometry>
          <material><ambient>0.50 0.30 0.10 1</ambient><diffuse>0.50 0.30 0.10 1</diffuse></material>
        </visual>
        <collision name="collision_l4">
          <pose>0 0 0.33 0 0 0</pose>
          <geometry><box><size>0.16 0.16 0.08</size></box></geometry>
        </collision>
        <visual name="visual_l4">
          <pose>0 0 0.33 0 0 0</pose>
          <geometry><box><size>0.16 0.16 0.08</size></box></geometry>
          <material><ambient>0.65 0.45 0.20 1</ambient><diffuse>0.65 0.45 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_obstacle_5">
      <static>true</static>
      <pose>1.95 2.10 0 0 0 0</pose>
      <link name="link">
        <collision name="collision_bottom">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.28 0.28 0.14</size></box></geometry>
        </collision>
        <visual name="visual_bottom">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.28 0.28 0.14</size></box></geometry>
          <material><ambient>0.55 0.35 0.12 1</ambient><diffuse>0.55 0.35 0.12 1</diffuse></material>
        </visual>
        <collision name="collision_top">
          <pose>0 0 0.22 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.14</size></box></geometry>
        </collision>
        <visual name="visual_top">
          <pose>0 0 0.22 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.14</size></box></geometry>
          <material><ambient>0.60 0.40 0.15 1</ambient><diffuse>0.60 0.40 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_obstacle_6">
      <static>true</static>
      <pose>1.05 3.90 0 0 0 0</pose>
      <link name="link">
        <collision name="collision_l1">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>0.28 0.28 0.09</size></box></geometry>
        </collision>
        <visual name="visual_l1">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><box><size>0.28 0.28 0.09</size></box></geometry>
          <material><ambient>0.55 0.35 0.12 1</ambient><diffuse>0.55 0.35 0.12 1</diffuse></material>
        </visual>
        <collision name="collision_l2">
          <pose>0 0 0.15 0 0 0</pose>
          <geometry><box><size>0.24 0.24 0.09</size></box></geometry>
        </collision>
        <visual name="visual_l2">
          <pose>0 0 0.15 0 0 0</pose>
          <geometry><box><size>0.24 0.24 0.09</size></box></geometry>
          <material><ambient>0.60 0.40 0.15 1</ambient><diffuse>0.60 0.40 0.15 1</diffuse></material>
        </visual>
        <collision name="collision_l3">
          <pose>0 0 0.24 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.09</size></box></geometry>
        </collision>
        <visual name="visual_l3">
          <pose>0 0 0.24 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.09</size></box></geometry>
          <material><ambient>0.50 0.30 0.10 1</ambient><diffuse>0.50 0.30 0.10 1</diffuse></material>
        </visual>
        <collision name="collision_l4">
          <pose>0 0 0.33 0 0 0</pose>
          <geometry><box><size>0.16 0.16 0.08</size></box></geometry>
        </collision>
        <visual name="visual_l4">
          <pose>0 0 0.33 0 0 0</pose>
          <geometry><box><size>0.16 0.16 0.08</size></box></geometry>
          <material><ambient>0.65 0.45 0.20 1</ambient><diffuse>0.65 0.45 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_obstacle_7">
      <static>true</static>
      <pose>0.90 1.95 0 0 0 0</pose>
      <link name="link">
        <collision name="collision_bottom">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.28 0.28 0.14</size></box></geometry>
        </collision>
        <visual name="visual_bottom">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><box><size>0.28 0.28 0.14</size></box></geometry>
          <material><ambient>0.55 0.35 0.12 1</ambient><diffuse>0.55 0.35 0.12 1</diffuse></material>
        </visual>
        <collision name="collision_top">
          <pose>0 0 0.22 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.14</size></box></geometry>
        </collision>
        <visual name="visual_top">
          <pose>0 0 0.22 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.14</size></box></geometry>
          <material><ambient>0.60 0.40 0.15 1</ambient><diffuse>0.60 0.40 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_obstacle_8">
