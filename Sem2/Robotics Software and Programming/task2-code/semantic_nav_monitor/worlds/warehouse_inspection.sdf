        </visual>
      </link>
    </model>

    <!-- ================= Centerline test obstacles =================
         Three small warning pylons on the (0,0)->(3,0) leg, straddling its
         centerline (y=0): left of path, right of path, dead-center. Each
         sits partially or fully inside the robot's ~0.23m corridor
         half-width, forcing a genuine detect-and-steer-around response. -->
    <model name="path_pylon_left">
      <static>true</static>
      <pose>0.80 0.30 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.09</radius><length>0.25</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.09</radius><length>0.25</length></cylinder></geometry>
          <material><ambient>0.85 0.35 0.05 1</ambient><diffuse>0.85 0.35 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="path_pylon_right">
      <static>true</static>
      <pose>1.60 -0.30 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.09</radius><length>0.25</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.09</radius><length>0.25</length></cylinder></geometry>
          <material><ambient>0.85 0.35 0.05 1</ambient><diffuse>0.85 0.35 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="path_pylon_center">
      <static>true</static>
      <pose>2.40 0.0 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.09</radius><length>0.25</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.09</radius><length>0.25</length></cylinder></geometry>
          <material><ambient>0.85 0.35 0.05 1</ambient><diffuse>0.85 0.35 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= Inspection checkpoint markers (visual-only, no collision) ================= -->
    <model name="checkpoint_marker_1">
      <static>true</static>
      <pose>3.0 0.0 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="checkpoint_marker_2">
      <static>true</static>
      <pose>3.0 3.0 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
